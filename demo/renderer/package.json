{
  "name": "lou-renderer",
  "version": "1.0.0",
  "private": true,
  "description": "Static chapter renderer for Lou Learning Companion",
  "type": "module",
  "scripts": {
    "postinstall": "mkdir -p lib && cp node_modules/marked/marked.min.js lib/marked.min.js",
    "test": "node --test test/*.test.js test/smoke/*.unit.test.js",
    "test:smoke": "playwright test",
    "test:smoke:product": "playwright test --project=product",
    "test:smoke:engineering": "playwright test --project=engineering",
    "test:all": "npm test && npm run test:smoke"
  },
  "dependencies": {
    "marked": "^15.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.49.0"
  }
}
